<rml>
    <head>
        <link type="text/rcss" href="../global.rcss"/>
        <link type="text/rcss" href="create_world.rcss"/>
    </head>

    <body class="page" data-model="create_world_scene">
    <div class="panel">
        <h1 class="dark_text">create_world</h1>

        <div class="panel_item">
            <label class="dark_text panel_item_label">world_name</label>
            <input type="text" class="dark_text panel_item_input_text" data-value="world_name"/>
            <button class="panel_item_button" data-event-click="on_random_name_click">random</button>
        </div>

        <div class="panel_item">
            <label class="dark_text panel_item_label">seed</label>
            <input type="text" class="dark_text panel_item_input_text" data-value="seed"/>
            <button class="panel_item_button" data-event-click="on_random_seed_click">random</button>
        </div>

        <div class="panel_item">
            <input type="checkbox" data-checked="allow_cheats"/>
            <label class="dark_text panel_item_checkbox_label">allow_cheats</label>
        </div>

        <div class="panel_item">
            <button class="panel_item_action_button_left" data-event-click="on_back_click">back</button>
            <button class="panel_item_action_button_right" data-event-click="on_create_world_click">create</button>
        </div>
    </div>

    </body>
</rml>
