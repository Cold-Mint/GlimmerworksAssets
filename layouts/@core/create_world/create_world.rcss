/* English: Styles for the create world page. */
/* 中文：创建世界页面样式。 */

.page {
    justify-content: center;
}

.card {
    width: 90%;
    max-width: 420dp;
    padding: 40dp;
    background-color: rgba(255, 255, 255, 0.05);
    border-top-left-radius: 16dp;
    border-top-right-radius: 16dp;
    border-bottom-right-radius: 16dp;
    border-bottom-left-radius: 16dp;
    border-top-width: 1dp;
    border-right-width: 1dp;
    border-bottom-width: 1dp;
    border-left-width: 1dp;
    border-top-color: rgba(255, 255, 255, 0.1);
    border-right-color: rgba(255, 255, 255, 0.1);
    border-bottom-color: rgba(255, 255, 255, 0.1);
    border-left-color: rgba(255, 255, 255, 0.1);
}

.card h1 {
    margin: 0 0 30dp 0;
    font-size: 28dp;
    font-weight: bold;
    color: #fff;
    text-align: center;
    letter-spacing: 1dp;
}

.field {
    display: flex;
    flex-direction: column;
    gap: 8dp;
    margin-bottom: 20dp;
}

.field label {
    font-size: 14dp;
    font-weight: bold;
    color: rgba(255, 255, 255, 0.8);
    text-transform: uppercase;
    letter-spacing: 0.5dp;
}

.input-row {
    display: flex;
    gap: 10dp;
}

.input-row input {
    flex: 1;
}

.input-row button {
    white-space: nowrap;
}

.actions {
    display: flex;
    flex-direction: column;
    gap: 15dp;
    margin-top: 30dp;
}

.actions button {
    width: 100%;
    padding: 16dp;
    position: relative;
    z-index: 1;
}
