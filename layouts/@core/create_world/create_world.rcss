.page {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

.panel_item {
    display: flex;
    flex-direction: row;
    align-items: center;
}

.panel_item_input_text {
    flex-grow: 1;
}

.panel_item_label {
    width: 64dp;
}

.panel_item_checkbox_label {
    margin-left: 8dp;
}

.dimension_select {
    margin-left: 16dp;
}

.panel_item_button {
    margin-left: 8dp;
    width: 128dp;
}

.panel_item_action_button_left {
    margin-right: 4dp;
    flex-grow: 1;
}

.panel_item_action_button_right{
    margin-left: 4dp;
    flex-grow: 1;
}

/* 创建世界：建议（强调）按钮 */
.panel_item_action_button_right {
    color: var(--accent-fg);
    border-color: var(--accent-hover);
    decorator: vertical-gradient(var(--accent-btn-top) var(--accent-btn-bottom));
}

.panel_item_action_button_right:hover {
    color: var(--accent-fg);
    border-color: var(--accent-active);
    decorator: vertical-gradient(var(--accent-btn-hover-top) var(--accent-btn-hover-bottom));
}

.panel_item_action_button_right:active {
    color: var(--accent-fg);
    border-color: var(--accent-active);
    decorator: vertical-gradient(var(--accent-btn-active-top) var(--accent-btn-active-bottom));
}
