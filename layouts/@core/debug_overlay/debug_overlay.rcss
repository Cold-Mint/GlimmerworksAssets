.debug_overlay_body {
    width: 100%;
    height: 100%;
    pointer-events: none;
}

.debug_coordinates {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
}

.debug_overlay_panel {
    position: absolute;
    bottom: 8dp;
    right: 8dp;
    padding: 4dp 12dp;
    background-color: rgba(0, 0, 0, 0.6);
    border-radius: 4dp;
}

.debug_overlay_text {
    color: #ffffff;
    font-size: 14dp;
}

.debug_coord_x {
    position: absolute;
    top: 2dp;
    color: #ffffff;
    font-size: 12dp;
}

.debug_coord_y {
    position: absolute;
    left: 2dp;
    color: #ffffff;
    font-size: 12dp;
}
