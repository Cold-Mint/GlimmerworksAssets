<rml>
    <head>
        <link type="text/rcss" href="../global.rcss"/>
        <link type="text/rcss" href="debug_overlay.rcss"/>
    </head>

    <body class="debug_overlay_body" data-model="debug_overlay_scene">
        <div class="debug_coordinates">
            <span data-for="label : x_coordinates">
                <span class="debug_coord_x" data-style-left="label.coordinate + 'px'">{{label.coordinate}}</span>
            </span>
            <span data-for="label : y_coordinates">
                <span class="debug_coord_y" data-style-top="label.coordinate + 'px'">{{label.coordinate}}</span>
            </span>
        </div>
        <div class="debug_overlay_panel">
            <span class="debug_overlay_text">{{fps_text}}</span>
        </div>
    </body>
</rml>
