	</div>
	<div id="tooltip_container">
		<template src="tooltip">
			<div class="tooltip_header">
				<img class="tooltip_icon"/>
				<div>
					<div class="tooltip_name"></div>
					<div class="tooltip_type"></div>
				</div>
			</div>
			<div class="tooltip_divider"></div>
			<div class="tooltip_description"></div>
			<div class="tooltip_stats">
				<div class="tooltip_stat">
					<span class="tooltip_stat_name"></span>
					<span class="tooltip_stat_value"></span>
				</div>
			</div>
			<div class="tooltip_footer"></div>
		</template>
	</div>
