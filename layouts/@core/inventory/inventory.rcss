.page {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    padding: 16dp;
    gap: 16dp;
}

.inventory_toolbar {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 8dp;
}


.item_container {
    display: flex;
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    flex-wrap: wrap;
    width: 442dp;
    gap: 8dp;
}

.recipe_container {
    display: flex;
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    flex-wrap: wrap;
    width: 442dp;
    gap: 8dp;
}

.item_slot.draggable {
    cursor: move;
    drag: clone;
}

.item_slot.draggable:drag {
    decorator: none;
}

.item_slot.draggable:drag .item_slot_count,
.item_slot.draggable:drag .durability_bar {
    display: none;
}
