<rml>
    <head>
        <link type="text/rcss" href="../global.rcss"/>
        <link type="text/rcss" href="hotbar.rcss"/>
    </head>

    <body class="page" data-model="hotbar">
    <div class="hotbar_container">
        <div class="item_slot" data-attrif-selected="slot.selected"
             data-for="slot : item_slots"
             data-event-mouseover="on_item_hover(it_index)"
             data-event-mouseout="on_item_out(it_index)">
            <div class="durability_bar" data-if="slot.durability != 0 && slot.durability != 100">
                <div class="durability_fill"
                     data-style-height="slot.durability + '%'"
                     data-class-durability-high="slot.durability > 70"
                     data-class-durability-mid="slot.durability >= 25 && slot.durability <= 70"
                     data-class-durability-low="slot.durability < 25">
                </div>
            </div>
            <img class="item_slot_icon" data-if="slot.image != ''" data-attr-src="slot.image"/>
            <span class="item_slot_count dark_text" data-if="slot.amount > 1">{{slot.amount}}</span>
        </div>
    </div>
    </body>
</rml>
