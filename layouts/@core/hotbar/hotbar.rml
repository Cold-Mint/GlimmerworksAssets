<rml>
    <head>
        <link type="text/rcss" href="../global.rcss"/>
        <link type="text/rcss" href="hotbar.rcss"/>
        <link type="text/template" href="../item_slot.rml"/>
    </head>

    <body class="page" data-model="hotbar">
    <div class="hotbar_container">
        <div class="item_slot" data-attrif-selected="slot.selected"
             data-for="slot : item_slots"
             data-event-mouseover="on_item_hover(it_index)"
             data-event-mouseout="on_item_out(it_index)">
            <template src="item_slot_content"/>
        </div>
    </div>
    </body>
</rml>
