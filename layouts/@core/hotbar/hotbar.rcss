.page {
    width: 100%;
    height: 100%;
    position: relative;
}

.hotbar_container {
    position: absolute;
    top: 16dp;
    left: 16dp;
    display: flex;
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    gap: 8dp;
    flex-wrap: wrap;
    width: 442dp;
}