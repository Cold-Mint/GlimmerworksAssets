.page {
    width: 100%;
    height: 100%;
    padding: 16dp;
}

.panel {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    gap: 12dp;
}

.detail_header {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
}

.output_info {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 8dp;
}

.output_name {
    font-size: 16dp;
}

.output_amount {
    font-size: 14dp;
}

.detail_body {
    display: flex;
    flex-direction: row;
    flex: 1;
    gap: 12dp;
}

.tag_progress_panel {
    display: flex;
    flex-direction: column;
    width: 180dp;
    gap: 12dp;
}

.tag_progress_item {
    display: flex;
    flex-direction: column;
    gap: 4dp;
}

.tag_name {
    font-size: 13dp;
}

.tag_count {
    font-size: 14dp;
}

.tag_satisfied {
    height: 6dp;
    background-color: var(--success);
    border-radius: 3dp;
}

.progress_fill {
    height: 6dp;
    background-color: var(--warning-alt);
    border-radius: 3dp;
}

.progress_bar {
    width: 100%;
    height: 6dp;
    display: flex;
    background-color: var(--border-light);
    border-radius: 3dp;
}

.item_choices_panel {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    flex: 1;
    gap: 8dp;
    overflow: auto;
}

.item_choice_card {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 240dp;
    padding: 8dp;
    gap: 4dp;
    background-color: var(--surface-alt);
    border: 1dp var(--border-light);
    border-radius: 8dp;
}

.item_name {
    font-size: 12dp;
}

.item_tags {
    font-size: 10dp;
}

.stepper {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 4dp;
}

.stepper_button {
    width: 48dp;
    height: 48dp;
    padding: 0dp;
    margin: 0dp;
    font-size: 16dp;
}

.stepper_value {
    width: 30dp;
    text-align: center;
    font-size: 14dp;
}

.backpack_count {
    font-size: 12dp;
}

.detail_footer {
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    gap: 12dp;
    width: 100%;
}

.craft_count_stepper {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 4dp;
}

.craft_count_value {
    width: 50dp;
    text-align: center;
    font-size: 14dp;
}

/* 合成：建议（强调）按钮 */
.detail_footer button:last-child {
    color: var(--accent-fg);
    border-color: var(--accent-hover);
    decorator: vertical-gradient(var(--accent-btn-top) var(--accent-btn-bottom));
}

.detail_footer button:last-child:hover {
    color: var(--accent-fg);
    border-color: var(--accent-active);
    decorator: vertical-gradient(var(--accent-btn-hover-top) var(--accent-btn-hover-bottom));
}

.detail_footer button:last-child:active {
    color: var(--accent-fg);
    border-color: var(--accent-active);
    decorator: vertical-gradient(var(--accent-btn-active-top) var(--accent-btn-active-bottom));
}

.detail_footer button:last-child[disabled] {
    color: var(--accent-fg);
    border-color: var(--accent-btn-disabled-border);
    decorator: vertical-gradient(var(--accent-btn-disabled-top) var(--accent-btn-disabled-bottom));
}
