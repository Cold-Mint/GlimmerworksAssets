/* 设置页：Adwaita 风格，左侧分组导航 + 右侧内容。 */
.page {
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
}

.settings_window {
    display: flex;
    flex-direction: row;
    width: 760dp;
    max-width: 92%;
    height: 90%;
    max-height: 90%;
    background-color: var(--surface);
    border: 1dp var(--border);
    border-radius: 12dp;
    overflow: hidden;
}

.settings_sidebar {
    display: flex;
    flex-direction: column;
    width: 220dp;
    flex-shrink: 0;
    padding: 12dp;
    gap: 8dp;
    background-color: var(--surface-alt);
    border-right: 1dp var(--border);
}

.settings_sidebar_header {
    font-size: 18dp;
    padding: 8dp 12dp;
}

.settings_sidebar_list {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 4dp;
    overflow-y: auto;
    overflow-x: hidden;
}

.settings_sidebar_item {
    padding: 8dp 12dp;
    border-radius: 8dp;
    cursor: pointer;
    color: var(--fg);
    font-size: 14dp;
}

.settings_sidebar_item:hover {
    background-color: var(--surface);
}

.settings_sidebar_item_selected {
    background-color: var(--accent);
    color: var(--accent-fg);
}

.settings_sidebar_item_selected:hover {
    background-color: var(--accent);
    color: var(--accent-fg);
}

.settings_sidebar_footer {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 8dp;
    padding: 8dp 12dp;
}

.settings_content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 12dp;
    padding: 20dp;
}

.settings_content_header {
    font-size: 18dp;
}

.settings_scroll {
    flex: 1;
    overflow-y: auto;
    overflow-x: hidden;
}

.settings_item {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 16dp;
    padding-top: 8dp;
    padding-bottom: 8dp;
    border-bottom-width: 1dp;
    border-bottom-color: var(--border-light);
}

.settings_label {
    flex: 1;
    font-size: 14dp;
}

.settings_control {
    width: 240dp;
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
}

.settings_control input[type="text"] {
    width: 100%;
}

.settings_control select {
    width: 100%;
}

.settings_control input[type="range"] {
    width: 100%;
}

.settings_buttons {
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
    gap: 8dp;
}

/* 建议（强调）保存按钮 */
.settings_save_button {
    color: var(--accent-fg);
    border-color: var(--accent-hover);
    decorator: vertical-gradient(var(--accent-btn-top) var(--accent-btn-bottom));
}

.settings_save_button:hover {
    color: var(--accent-fg);
    border-color: var(--accent-active);
    decorator: vertical-gradient(var(--accent-btn-hover-top) var(--accent-btn-hover-bottom));
}

.settings_save_button:active {
    color: var(--accent-fg);
    border-color: var(--accent-active);
    decorator: vertical-gradient(var(--accent-btn-active-top) var(--accent-btn-active-bottom));
}
