.console {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    padding: 8dp;
    background-color: #1c1c1c99;
    gap: 8dp;

}

.top_content {
    display: flex;
    flex-grow: 1;
    overflow-y: auto;
    overflow-x: hidden;
    flex-direction: column;
    padding: 6dp;
    border-radius: 4dp;
}

.bottom_bar {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    width: 100%;
    height: auto;
    box-sizing: border-box;
}

.input_wrap {
    position: relative;
    width: 100%;
    height: 32dp;
    display: flex;
    align-items: center;
}

.console_input {
    height: 100%;
    width: 100%;
    padding: 8dp;
    border-radius: 4dp;
    position: relative;
    z-index: 2;
    font-size: 14dp;
    line-height: 100%;
    margin: 0;
}

.command_structure {
    padding: 8dp;
    font-size: 14dp;
}

.command_suggestion{
    display: flex;
    flex-direction: column;
        font-size: 14dp;
    gap: 4dp;
    padding: 6dp
}

.command_structure_selected {
    color: red
}

.autocomplete_tip {
    position: absolute;
    top: 0;
    height: 100%;
    padding: 8dp;
    width: 100%;
    line-height: 100%;
    color: #555555;
    font-size: 14dp;
    z-index: 1;
}