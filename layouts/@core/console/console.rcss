/* 控制台：跟随亮/暗主题的终端。 */
.console {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    padding: 8dp;
    background-color: var(--console-bg);
    color: var(--console-fg);
    gap: 16dp;
}

input[type="text"] {
    width: 100%;
    padding-left: 12dp;
    padding-right: 8dp;
    padding-top: 16dp;
    padding-bottom: 16dp;
    color: var(--console-fg);
    z-index: 2;
    font-size: 14dp;
    caret-color: var(--accent);
    background-color: transparent;
    border-width: 0dp;
    border-color: transparent;
    border-radius: 0dp;
}

.top_content {
    display: flex;
    flex-grow: 1;
    overflow-y: auto;
    overflow-x: hidden;
    flex-direction: column;
    padding: 8dp;
    background-color: var(--console-panel-bg);
    border: 1dp var(--console-border);
    border-radius: 8dp;
}

.top_content_label {
    font-size: 14dp;
    padding-top: 4dp;
    padding-bottom: 4dp;
    border-bottom-width: 1dp;
    border-bottom-color: var(--console-divider);
}

.command_structure_item {
    color: var(--console-structure);
}

.command_structure_item_selected {
    color: var(--console-structure-selected);
}

.bottom_bar {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    width: 100%;
    height: auto;
    box-sizing: border-box;
}

.input_wrap {
    position: relative;
    width: 100%;
    height: 32dp;
    margin-top: 16dp;
    margin-bottom: 8dp;
    display: flex;
    align-items: center;
}

.command_structure {
    margin-top: 16dp;
    padding: 8dp;
    font-size: 14dp;
    background-color: var(--console-inset-bg);
    border: 1dp var(--console-border);
    border-radius: 8dp;
}

.suggestion_keyword {
    font-size: 14dp;
    color: var(--console-keyword);
    padding: 0dp;
}

.suggestion {
    font-size: 14dp;
    color: var(--console-suggestion);
    padding: 0dp;
}

.suggestion_list {
    display: flex;
    flex-direction: column;
    gap: 4dp;
    padding: 6dp;
    max-height: 25vh;
    overflow-y: auto;
    overflow-x: hidden;
    background-color: var(--console-inset-bg);
    border: 1dp var(--console-border);
    border-radius: 8dp;
}

.suggestion_list scrollbarvertical {
    width: 1dp;
}

.suggestion_item {
    display: flex;
    flex-direction: row;
    gap: 0dp;
    padding: 4dp 10dp 4dp 6dp;
    cursor: pointer;
    border-radius: 4dp;
}

.suggestion_item_selected {
    background-color: var(--accent);
}

.suggestion_item_selected .suggestion,
.suggestion_item_selected .suggestion_keyword {
    color: var(--accent-fg);
}

.autocomplete_tip {
    position: absolute;
    inset: 0;
    top: 8dp;
    left: 12dp;
    color: var(--console-muted);
    font-size: 14dp;
    z-index: 1;
}
