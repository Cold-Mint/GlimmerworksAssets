.console {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    padding: 8dp;
    decorator: image("texture://@core:console_gui/console_background");
    gap: 16dp;
}

input[type="text"] {
    width: 100%;
    padding-left: 12dp;
    padding-right: 8dp;
    padding-top: 16dp;
    padding-bottom: 16dp;
    color: white;
    z-index: 2;
    font-size: 14dp;
    decorator: ninepatch-texture("texture://@core:console_gui/input_text", 12px, 12px, 12px, 12px);
}


.top_content {
    display: flex;
    flex-grow: 1;
    overflow-y: auto;
    overflow-x: hidden;
    flex-direction: column;
    padding: 8dp;
    decorator: ninepatch-texture("texture://@core:console_gui/panel", 12px, 12px, 12px, 12px);
}

.top_content_label {
    font-size: 14dp;
    padding-top: 4dp;
    padding-bottom: 4dp;
    border-bottom-width: 1dp;
    border-bottom-color: white;
}

.command_structure_item {
    color: #00ffff;
}

.command_structure_item_selected {
    color: #00ff00;
}

.bottom_bar {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    width: 100%;
    height: auto;
    box-sizing: border-box;
}

.input_wrap {
    position: relative;
    width: 100%;
    height: 32dp;
    margin-top: 16dp;
    margin-bottom: 8dp;
    display: flex;
    align-items: center;
}

.command_structure {
    margin-top: 16dp;
    padding: 8dp;
    font-size: 14dp;
    decorator: ninepatch-texture("texture://@core:console_gui/panel", 12px, 12px, 12px, 12px);
}

.suggestion_keyword {
    font-size: 14dp;
    color: #00ff00;
    padding: 0dp;
}

.suggestion {
    font-size: 14dp;
    color: #00ffff;
    padding: 0dp;
}


.suggestion_list {
    display: flex;
    flex-direction: column;
    gap: 4dp;
    padding: 6dp;
    max-height: 25vh;
    overflow-y: auto;
    overflow-x: hidden;
    decorator: ninepatch-texture("texture://@core:console_gui/panel", 12px, 12px, 12px, 12px);
}

.suggestion_list scrollbarvertical {
    width: 1dp;
}

.suggestion_item {
    display: flex;
    flex-direction: row;
    gap: 0dp;
    padding: 4dp 10dp 4dp 6dp;
    cursor: pointer;
}

.suggestion_item_selected {
    background-color: #D3D3D3;
}

.autocomplete_tip {
    position: absolute;
    inset: 0;
    top: 8dp;
    left: 12dp;
    color: #555555;
    font-size: 14dp;
    z-index: 1;
}
