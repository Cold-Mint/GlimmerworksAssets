/* English: Styles for the console overlay page. */
/* 中文：控制台覆盖层页面样式。 */

.console {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    padding: 8dp;
    background-color: #1c1c1c;
    gap: 8dp;

}

.top_content {
    display: flex;
    flex-grow: 1;
    overflow-y: auto;
    overflow-x: hidden;
    flex-direction: column;
    padding: 6dp;
    border-radius: 4dp;
}

.command_structure_item {
    color: #00ffff;
}

.command_structure_item_selected {
    color: #00ff00;
}

.bottom_bar {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    width: 100%;
    height: auto;
    box-sizing: border-box;
}

.input_wrap {
    position: relative;
    width: 100%;
    height: 32dp;
    display: flex;
    align-items: center;
}

.console_input {
    height: 100%;
    width: 100%;
    padding: 8dp;
    border-radius: 4dp;
    position: relative;
    z-index: 2;
    font-size: 14dp;
    line-height: 100%;
    margin: 0;
}

.command_structure {
    padding: 8dp;
    font-size: 14dp;
}

.suggestion_keyword {
    font-size: 14dp;
    color: #00ff00;
    padding: 0dp;
}

.suggestion {
    font-size: 14dp;
    color: #00ffff;
    padding: 0dp;
}


.suggestion_list {
    display: flex;
    flex-direction: column;
    gap: 4dp;
    padding: 6dp;
    max-height: 25vh;
    overflow-y: auto;
    overflow-x: hidden;
    position: relative;
}

.suggestion_list scrollbarvertical {
    width: 12dp;
}

.suggestion_list scrollbarvertical slidertrack {
    background-color: rgba(255, 255, 255, 0.1);
}

.suggestion_list scrollbarvertical sliderbar {
    width: 12dp;
    min-height: 20dp;
    background-color: rgba(255, 255, 255, 0.3);
}

.suggestion_list scrollbarvertical sliderbar:hover {
    background-color: rgba(255, 255, 255, 0.5);
}



.suggestion_item {
    display: flex;
    flex-direction: row;
    gap: 0dp;
    padding: 4dp 10dp 4dp 6dp;
    cursor: pointer;
}

.suggestion_item_selected{
background-color: #D3D3D3;
}

.autocomplete_tip {
    position: absolute;
    top: 0;
    height: 100%;
    padding: 8dp;
    width: 100%;
    line-height: 100%;
    color: #555555;
    font-size: 14dp;
    z-index: 1;
}
