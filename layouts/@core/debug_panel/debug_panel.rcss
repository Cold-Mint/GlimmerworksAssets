.debug_panel_body {
    width: 100%;
    height: 100%;
    pointer-events: none;
}

.debug_crosshair_h {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 1px;
    background-color: #ffe600c7;
}

.debug_crosshair_v {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 100%;
    background-color: #ffe600c7;
}

.debug_text_list {
    position: absolute;
    top: 8dp;
    right: 8dp;
    display: block;
    text-align: right;
}

.debug_text_line {
    display: block;
    margin-bottom: 2dp;
    padding: 2dp 8dp;
    background-color: #1414169e;
    color: #ffffff;
    font-size: 12dp;
    border-radius: 4dp;
}

.debug_chunk_info {
    position: absolute;
    bottom: 8dp;
    left: 8dp;
    padding: 4dp 12dp;
    background-color: #1414169e;
    color: #ffffff;
    font-size: 12dp;
    border-radius: 4dp;
}
