<rml>
    <head>
        <link type="text/rcss" href="../global.rcss"/>
        <link type="text/rcss" href="storage.rcss"/>
        <link type="text/template" href="../item_slot.rml"/>
    </head>
    <body class="page" data-model="storage">
    <div class="storage_panel">
        <div class="storage_header">
            <span class="storage_title dark_text">chest</span>
            <button class="storage_back" data-event-click="on_back_click">back</button>
        </div>
        <div class="storage_toolbar">
            <button data-event-click="on_deposit_all_click">deposit_all</button>
            <button data-event-click="on_quick_stack_click">quick_stack</button>
            <button data-event-click="on_loot_all_click">loot_all</button>
            <button data-event-click="on_restock_click">restock</button>
        </div>
        <div class="storage_body">
            <div class="storage_column">
                <div class="storage_column_header">
                    <span class="storage_label dark_text">inventory</span>
                    <button data-event-click="on_sort_player_click">sort</button>
                </div>
                <div class="item_container" id="player_container">
                    <div class="item_slot draggable"
                         data-for="slot : player_slots"
                         data-attr-data-slot-index="slot.index"
                         data-event-mouseover="on_player_item_hover(slot.index)"
                         data-event-mouseout="on_item_out()">
                        <template src="item_slot_content"/>
                    </div>
                </div>
            </div>
            <div class="storage_column">
                <div class="storage_column_header">
                    <span class="storage_label dark_text">chest</span>
                    <button data-event-click="on_sort_chest_click">sort</button>
                </div>
                <div class="item_container" id="chest_container">
                    <div class="item_slot draggable"
                         data-for="slot : chest_slots"
                         data-attr-data-slot-index="slot.index"
                         data-event-mouseover="on_chest_item_hover(slot.index)"
                         data-event-mouseout="on_item_out()">
                        <template src="item_slot_content"/>
                    </div>
                </div>
            </div>
            <div class="storage_column" data-if="show_loot">
                <div class="storage_column_header">
                    <span class="storage_label dark_text">loot</span>
                    <button data-event-click="on_loot_take_all_click">take_all</button>
                </div>
                <div class="item_container" id="loot_container">
                    <div class="item_slot draggable"
                         data-for="slot : loot_slots"
                         data-attr-data-slot-index="slot.index"
                         data-event-mouseover="on_loot_item_hover(slot.index)"
                         data-event-mouseout="on_item_out()">
                        <template src="item_slot_content"/>
                    </div>
                </div>
            </div>
        </div>
    </div>
    </body>
</rml>
