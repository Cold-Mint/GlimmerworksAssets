.page {
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
}

.storage_panel {
    display: flex;
    flex-direction: column;
    gap: 12dp;
    padding: 16dp;
    background-color: var(--surface);
    border: 1dp var(--border);
    border-radius: 12dp;
}

.storage_header {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.storage_title {
    font-size: 18dp;
}

.storage_toolbar {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 8dp;
}

.storage_body {
    display: flex;
    flex-direction: row;
    gap: 16dp;
}

.storage_column {
    display: flex;
    flex-direction: column;
    gap: 8dp;
}

.storage_column_header {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.storage_label {
    font-size: 14dp;
}

.item_container {
    display: flex;
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    flex-wrap: wrap;
    width: 442dp;
    gap: 8dp;
}

.item_slot.draggable {
    cursor: move;
    drag: clone;
}

.item_slot.draggable:drag {
    decorator: none;
    background-color: transparent;
    border: 0dp;
}

.item_slot.draggable:drag .item_slot_count,
.item_slot.draggable:drag .durability_bar {
    display: none;
}
