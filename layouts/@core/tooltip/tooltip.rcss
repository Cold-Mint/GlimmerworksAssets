.page {
    pointer-events: none;
    position: absolute;
    display: inline-block;
    padding: 16dp;
    z-index: 1000;
    background-color: var(--toast-bg);
    color: #ffffff;
    border: 1dp var(--toast-border);
    border-radius: 8dp;
}

.page label {
    display: block;
}

.tip_positive {
    color: var(--success-text);
}

.tip_negative {
    color: var(--danger-text);
}
