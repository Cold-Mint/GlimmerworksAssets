.page {
    pointer-events: none;
    position: absolute;
    display: inline-block;
    padding: 16dp;
    z-index: 1000;
    background-color: var(--tooltip-bg);
    border: 1dp var(--border);
    border-radius: 8dp;
}

.page label {
    display: block;
}

.tip_positive {
    color: var(--success-text);
}

.tip_negative {
    color: var(--danger-text);
}
