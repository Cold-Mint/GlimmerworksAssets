.page {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

input[type="text"] {
    width: 100%;
}

.search_bar {
    position: relative;
}

.cheat_mode {
    color: var(--danger);
}

.search_icon {
    position: absolute;
    right: 16dp;
    top: 10dp;
    width: 24dp;
    height: 24dp;
}

.save_item {
    cursor: pointer;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 8dp;
    padding: 16dp;
    border: 1dp transparent;
    border-radius: 8dp;
}

.save_keyword {
    color: var(--success-text);
}

.save_item.selected {
    background-color: var(--slot-selected-bg);
    border-color: var(--accent);
}

.save_list {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    overflow-x: hidden;
}

.no_saves {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

.panel {
    position: absolute;
    width: 90%;
    top: 5%;
    left: 5%;
    right: 5%;
    bottom: 5%;
}

.action_buttons {
    display: flex;
    flex-direction: row;
    gap: 8dp;
}

.action_buttons_area{
     display: flex;
    flex-direction: column;
    gap:8dp;
}

button {
    margin: 0dp;
    flex: 1;
}

/* 删除存档：破坏性按钮 */
.delete_button {
    color: var(--accent-fg);
    border-color: var(--danger-btn-border);
    decorator: vertical-gradient(var(--danger-btn-top) var(--danger-btn-bottom));
}

.delete_button:hover {
    color: var(--accent-fg);
    border-color: var(--danger-btn-active-bottom);
    decorator: vertical-gradient(var(--danger-btn-hover-top) var(--danger-btn-hover-bottom));
}

.delete_button:active {
    color: var(--accent-fg);
    border-color: var(--danger-btn-active-bottom);
    decorator: vertical-gradient(var(--danger-btn-active-top) var(--danger-btn-active-bottom));
}

/* 禁用态：覆盖悬停/按下，保持灰色禁用样式 */
.delete_button[disabled],
.delete_button[disabled]:hover,
.delete_button[disabled]:active {
    cursor: default;
    color: var(--fg-muted);
    border-color: var(--border-light);
    decorator: vertical-gradient(var(--btn-disabled-top) var(--btn-disabled-bottom));
}
