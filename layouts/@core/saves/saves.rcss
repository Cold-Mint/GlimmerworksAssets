/* English: Styles for the saved games page. */
/* 中文：存档页面样式。 */

.page {
    flex-direction: column;
}

.title {
    margin-top: 40dp;
    font-size: 28dp;
    letter-spacing: 1dp;
}

.save_list {
    margin-top: 80dp;
    margin-bottom: 120dp;
    width: 60%;
    max-width: 400dp;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
}

.save_item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 15dp;
    margin-bottom: 10dp;
    background-color: rgba(255, 255, 255, 0.1);
    border-top-left-radius: 8dp;
    border-top-right-radius: 8dp;
    border-bottom-right-radius: 8dp;
    border-bottom-left-radius: 8dp;
    cursor: pointer;
    border-top-width: 1dp;
    border-right-width: 1dp;
    border-bottom-width: 1dp;
    border-left-width: 1dp;
    border-top-color: rgba(255, 255, 255, 0.1);
    border-right-color: rgba(255, 255, 255, 0.1);
    border-bottom-color: rgba(255, 255, 255, 0.1);
    border-left-color: rgba(255, 255, 255, 0.1);
}

.save_item:hover {
    background-color: rgba(255, 255, 255, 0.15);
}

.save_item.selected {
    background-color: rgba(74, 144, 217, 0.3);
    border-top-color: #4a90d9;
    border-right-color: #4a90d9;
    border-bottom-color: #4a90d9;
    border-left-color: #4a90d9;
}

.save_label {
    flex: 1;
    font-size: 16dp;
    color: #fff;
    white-space: pre-wrap;
    line-height: 1.4;
}

.delete_button {
    margin-left: 10dp;
}

.no_saves {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    font-size: 18dp;
    color: rgba(255, 255, 255, 0.5);
}

.button_container {
    position: absolute;
    bottom: 40dp;
    left: 0;
    right: 0;
    flex-direction: row;
    justify-content: center;
    gap: 30dp;
    z-index: 10;
}

.button_container button {
    width: 150dp;
    flex-shrink: 0;
}
