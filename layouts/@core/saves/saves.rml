<rml>
    <head>
        <link type="text/rcss" href="../global.rcss"/>
        <link type="text/rcss" href="saves.rcss"/>
    </head>

    <body class="page" data-model="saved_games_scene">
    <div class="panel">
        <h1 class="dark_text">saves_list</h1>
        <div class="search_bar">
            <img class="search_icon" src="texture://@core:gui/search_icon"/>
            <input type="text" class="dark_text"/>
        </div>

        <div class="save_list" data-if="save_items.size > 0">
            <div class="save_item" data-for="save_item : save_items" data-event-click="on_save_click(save_item.index)"
                 data-class-selected="save_item.selected">
                <h2 class="dark_text save_label">{{save_item.name}}</h2>
                <h3 data-if="save_item.allow_cheats" class="cheat_mode">cheats_mode</h3>
                <label class="dark_text save_label">{{save_item.last_played_time}}</label>
            </div>
        </div>
        <div class="no_saves" data-if="save_items.size == 0">
            <p>No saves</p>
        </div>
        <div class="action_buttons">
            <button disabled>load_game</button>
            <button data-event-click="on_new_game_click">create_world</button>
            <button data-event-click="on_back_click">back</button>
            <button class="delete_button" data-event-click="on_delete_click(save_item.index)">delete_game</button>
        </div>
    </div>
    </body>
</rml>
