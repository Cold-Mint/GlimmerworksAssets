<rml>
    <head>
        <link type="text/rcss" href="../global.rcss" />
        <link type="text/rcss" href="saves.rcss" />
    </head>

    <body class="page" data-model="saved_games_scene">
        <p class="title">saved_games</p>
        <div class="save_list" data-if="save_items.size > 0">
            <div class="save_item" data-for="save_item : save_items" data-event-click="on_save_click(save_item.index)" data-class-selected="save_item.selected">
                <div class="save_label">{{save_item.label}}</div>
                <button class="delete_button" data-event-click="on_delete_click(save_item.index)">delete_game</button>
            </div>
        </div>
        <div class="no_saves" data-if="save_items.size == 0">
            <p>No saves</p>
        </div>
        <div class="button_container">
            <button data-event-click="on_new_game_click">new_game</button>
            <button data-event-click="on_back_click">back</button>
        </div>
    </body>
</rml>