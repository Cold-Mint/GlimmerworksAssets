<rml>
    <head>
        <link type="text/rcss" href="../global.rcss"/>
        <link type="text/rcss" href="pause.rcss"/>
    </head>
    <body class="page" data-model="pause_system">
    <div class="panel">
        <h1 class="title dark_text">pause</h1>
        <button id="resume_game" data-event-click="on_resume_button_click">resume_game</button>
        <button id="save_and_exit" data-event-click="on_save_and_exit_button_click">save_and_exit</button>
    </div>
    </body>
</rml>
