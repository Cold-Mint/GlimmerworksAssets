.page {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    pointer-events: none;
}

.overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.6);
    pointer-events: auto;
}

.menu_container {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    pointer-events: auto;
    z-index: 100;
}

.title {
    font-size: 32dp;
    font-weight: bold;
    color: #fff;
    text-align: center;
    letter-spacing: 2dp;
    margin-bottom: 30dp;
}

.button_container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 15dp;
}

.button_container button {
    width: 200dp;
}