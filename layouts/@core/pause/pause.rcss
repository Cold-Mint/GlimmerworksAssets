/* English: Styles for the pause menu page. */
/* 中文：暂停菜单页面样式。 */

.page {
    flex-direction: column;
    justify-content: center;
    pointer-events: none;
}

.overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.6);
    pointer-events: auto;
}

.menu_container {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    pointer-events: auto;
    z-index: 100;
}

.title {
    font-size: 32dp;
    letter-spacing: 2dp;
    margin-bottom: 30dp;
}
