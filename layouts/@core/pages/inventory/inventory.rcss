#inventory {
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.5);
}

#inventory_container {
    width: 380dp;
    background-color: rgba(15, 15, 30, 0.95);
    border-top-width: 3dp;
    border-right-width: 3dp;
    border-bottom-width: 3dp;
    border-left-width: 3dp;
    border-top-color: #6a6a9a;
    border-right-color: #3a3a6a;
    border-bottom-color: #3a3a6a;
    border-left-color: #6a6a9a;
    box-shadow: 0 8dp 32dp rgba(0, 0, 0, 0.6);
}

#inventory_header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12dp 16dp;
    background-color: rgba(30, 30, 50, 0.8);
    border-bottom-width: 2dp;
    border-bottom-color: #4a4a6a;
}

#inventory_title {
    font-size: 18dp;
    font-weight: bold;
    color: #ffffff;
}

#close_button {
    width: 32dp;
    height: 32dp;
    padding: 0;
    font-size: 18dp;
    background-color: rgba(255, 68, 68, 0.2);
    border-top-width: 2dp;
    border-right-width: 2dp;
    border-bottom-width: 2dp;
    border-left-width: 2dp;
    border-top-color: #ff6b6b;
    border-right-color: #cc5555;
    border-bottom-color: #cc5555;
    border-left-color: #ff6b6b;
    color: #ff6b6b;
}

#close_button:hover {
    background-color: rgba(255, 68, 68, 0.4);
}

#inventory_grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 6dp;
    padding: 16dp;
}

.inventory_slot {
    cursor: pointer;
}

#inventory_hotbar {
    padding: 12dp 16dp 16dp;
    border-top-width: 2dp;
    border-top-color: #4a4a6a;
}

#hotbar_label {
    font-size: 14dp;
    color: #a0a0c0;
    margin-bottom: 8dp;
}

#hotbar_slots {
    display: flex;
    gap: 6dp;
}

.inventory_hotbar_slot {
    cursor: pointer;
}

#tooltip_container {
    position: fixed;
    pointer-events: none;
}