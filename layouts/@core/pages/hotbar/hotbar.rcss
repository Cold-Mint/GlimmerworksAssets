.hotbar {
    width: 100%;
    height: 100%;
    position: relative;
    pointer-events: none;
}

.hotbar_container {
    position: absolute;
    top: 20dp;
    left: 20dp;
    display: flex;
    gap: 8dp;
    padding: 12dp;
    pointer-events: auto;
}

.hotbar_slot {
    cursor: pointer;
}

.hotbar_slot .item_slot {
    width: 48dp;
    height: 48dp;
    border-top-width: 2dp;
    border-right-width: 2dp;
    border-bottom-width: 2dp;
    border-left-width: 2dp;
    position: relative;
    overflow: hidden;
    background-color: rgba(0, 0, 0, 0.3);
}

.hotbar_slot .item_slot:hover {
    border-top-color: #6a6a8a;
    border-right-color: #4a4a6a;
    border-bottom-color: #4a4a6a;
    border-left-color: #6a6a8a;
}

.hotbar_slot .item_slot.selected {
    border-top-color: #ffd700;
    border-right-color: #b8860b;
    border-bottom-color: #b8860b;
    border-left-color: #ffd700;
}

.hotbar_slot .item_slot.empty {
    border-top-color: #3a3a5a;
    border-right-color: #252545;
    border-bottom-color: #252545;
    border-left-color: #3a3a5a;
}

.hotbar_slot .slot_content {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
}

.hotbar_slot .item_icon {
    width: 36dp;
    height: 36dp;
}

.hotbar_slot .item_count {
    position: absolute;
    bottom: 2dp;
    left: 2dp;
    font-size: 12dp;
    font-weight: bold;
    color: #ffffff;
    pointer-events: none;
}