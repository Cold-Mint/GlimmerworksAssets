.hotbar {
    width: 100%;
    height: 100%;
    position: relative;
    pointer-events: none;
}

.hotbar_container {
    position: absolute;
    top: 20dp;
    left: 20dp;
    display: flex;
    gap: 8dp;
    padding: 12dp;
    pointer-events: auto;
}

.hotbar_slot {
    cursor: pointer;
}

.hotbar_slot .item_slot {
}

.hotbar_slot .item_slot.selected {
    animation: pulse 1s infinite;
}

#tooltip_container {
    position: absolute;
    pointer-events: none;
}