<rml>

	<head>
		<link type="text/rcss" href="../../global.rcss" />
		<link type="text/rcss" href="hotbar.rcss" />
		<link type="text/template" href="../../templates/item_slot/item_slot.rml" />
		<link type="text/template" href="../../templates/tooltip/tooltip.rml" />
	</head>

	<body class="hotbar">
		<div class="hotbar_container">
			<div id="slot_0" class="hotbar_slot" data-slot-index="0">
				<template src="item_slot">
					<img class="item_icon" />
					<span class="item_count hidden"></span>
				</template>
			</div>
			<div id="slot_1" class="hotbar_slot" data-slot-index="1">
				<template src="item_slot">
