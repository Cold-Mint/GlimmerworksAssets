					<img class="item_icon" />
					<span class="item_count hidden"></span>
				</template>
			</div>
			<div id="slot_8" class="hotbar_slot" data-slot-index="8">
				<template src="item_slot">
					<img class="item_icon" />
					<span class="item_count hidden"></span>
				</template>
