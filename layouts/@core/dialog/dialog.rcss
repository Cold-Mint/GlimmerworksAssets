/* 通用对话框：Adwaita 风格模态窗口。 */
.dialog_page {
    width: 100%;
    height: 100%;
}

.dialog_scrim {
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: #00000052;
}

.dialog_panel {
    display: flex;
    flex-direction: column;
    gap: 16dp;
    width: 360dp;
    max-width: 90%;
    padding: 24dp;
    background-color: var(--surface);
    border: 1dp var(--border);
    border-radius: 12dp;
}

.dialog_title {
    font-size: 18dp;
    color: var(--fg);
}

.dialog_message {
    font-size: 14dp;
    color: var(--fg);
    white-space: pre-line;
}

.dialog_button_row {
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
    gap: 8dp;
    margin-top: 8dp;
}

.dialog_button_row button {
    width: auto;
    min-width: 96dp;
    padding-left: 16dp;
    padding-right: 16dp;
    padding-top: 8dp;
    padding-bottom: 8dp;
}

/* 建议操作（强调按钮，蓝色） */
.dialog_button_suggested {
    color: var(--accent-fg);
    border-color: var(--accent-hover);
    decorator: vertical-gradient(var(--accent-btn-top) var(--accent-btn-bottom));
}

.dialog_button_suggested:hover {
    color: var(--accent-fg);
    border-color: var(--accent-active);
    decorator: vertical-gradient(var(--accent-btn-hover-top) var(--accent-btn-hover-bottom));
}

.dialog_button_suggested:active {
    color: var(--accent-fg);
    border-color: var(--accent-active);
    decorator: vertical-gradient(var(--accent-btn-active-top) var(--accent-btn-active-bottom));
}

/* 破坏性操作（危险按钮，红色） */
.dialog_button_destructive {
    color: var(--accent-fg);
    border-color: var(--danger-btn-border);
    decorator: vertical-gradient(var(--danger-btn-top) var(--danger-btn-bottom));
}

.dialog_button_destructive:hover {
    color: var(--accent-fg);
    border-color: var(--danger-btn-active-bottom);
    decorator: vertical-gradient(var(--danger-btn-hover-top) var(--danger-btn-hover-bottom));
}

.dialog_button_destructive:active {
    color: var(--accent-fg);
    border-color: var(--danger-btn-active-bottom);
    decorator: vertical-gradient(var(--danger-btn-active-top) var(--danger-btn-active-bottom));
}
