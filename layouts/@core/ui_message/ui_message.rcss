.ui_message_body {
    width: 100%;
    height: 100%;
    pointer-events: none;
}

.ui_message_list {
    position: absolute;
    bottom: 32dp;
    left: 0;
    right: 0;
    display: block;
    text-align: center;
}

.ui_message_item {
    display: block;
    margin: 4dp 0;
    animation: ui_message_fade_in 0.2s ease-out;
}

.ui_message_text {
    display: inline-block;
    padding: 4dp 12dp;
    background-color: rgba(0, 0, 0, 0.6);
    color: #ffffff;
    border-radius: 4dp;
    font-size: 14dp;
}

@keyframes ui_message_fade_in {
    from { opacity: 0; }
    to   { opacity: 1; }
}
