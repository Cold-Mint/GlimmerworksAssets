* {
    font-family: core;
    box-sizing: border-box;
}

a {
    cursor: pointer;
    color: #818cf8;
    text-decoration: none;
}

a:hover {
    color: #a5b4fc;
    text-decoration: underline;
}

button {
    width: 200dp;
    text-align: center;
    padding-left: 8dp;
    padding-right: 8dp;
    padding-top: 16dp;
    padding-bottom: 16dp;
    cursor: pointer;
    decorator: ninepatch-texture("texture://@core:gui/button", 4px, 4px, 4px, 4px);
}

button:hover {
    decorator: ninepatch-texture("texture://@core:gui/button_hovered", 4px, 4px, 4px, 4px);
}

button:active {
    decorator: ninepatch-texture("texture://@core:gui/button_pressed", 4px, 4px, 4px, 4px);
}

button[disabled] {
    cursor: default;
    opacity: 0.6;
    color: #888888;
    decorator: ninepatch-texture("texture://@core:gui/button_disabled", 8px, 8px, 8px, 8px);
}

.panel {
    padding: 24dp;
    width: 560dp;
    display: flex;
    flex-direction: column;
    gap: 16dp;
    decorator: ninepatch-texture("texture://@core:gui/panel_bg", 8px, 8px, 8px, 8px);
}

.dark_text {
    color: black;
}

input[type="text"] {
    width: 200dp;
    padding-left: 12dp;
    padding-right: 8dp;
    padding-top: 16dp;
    padding-bottom: 16dp;
    cursor: text;
    decorator: ninepatch-texture("texture://@core:gui/input_text", 8px, 8px, 8px, 8px);
}

input[type="checkbox"] {
    width: 32dp;
    height: 32dp;
    cursor: pointer;
    decorator: ninepatch-texture("texture://@core:gui/check_box", 2px, 2px, 2px, 2px);
}

input[type="checkbox"]:checked {
    decorator: ninepatch-texture("texture://@core:gui/check_box_checked", 2px, 2px, 2px, 2px);
}

h1 {
    font-size: 24dp;
}

h2 {
    font-size: 18dp;
}

h3 {
    font-size: 14dp;
}

.item_slot {
    position: relative;
    width: 42dp;
    height: 42dp;
    display: flex;
    justify-content: center;
    align-items: center;
    decorator: ninepatch-texture("texture://@core:gui/item_slot", 8px, 8px, 8px, 8px);
}


.recipe_slot {
    position: relative;
    width: 42dp;
    height: 42dp;
    display: flex;
    justify-content: center;
    align-items: center;
    decorator: ninepatch-texture("texture://@core:gui/craft_preview_slot", 8px, 8px, 8px, 8px);
}

.item_slot[selected] {
    decorator: ninepatch-texture("texture://@core:gui/item_slot_selected", 8px, 8px, 8px, 8px);
}

.item_slot_icon {
    width: 32dp;
    height: 32dp;
}

.item_slot_count {
    position: absolute;
    bottom: 4dp;
    right: 4dp;
    font-size: 14dp;
}
