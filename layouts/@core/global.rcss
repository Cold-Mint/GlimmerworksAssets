/*
 * GlimmerWorks — Adwaita / GNOME 风格主题（变量 + 亮/暗双主题）
 * 仅修改样式（颜色、圆角、边框、渐变），不改动布局。
 *
 * - 语义化 CSS 变量统一在 body 上定义，亮色为默认，暗色通过
 *   `@media (theme: dark)` 覆盖，引擎侧调用 Context::ActivateTheme("dark", true/false) 切换。
 * - 以 RCSS 属性（background-color、border、border-radius、vertical-gradient）
 *   替代纹理 decorator。
 * - 注意：当前 SDL_GPU 渲染后端未实现离屏渲染（layer / callback texture /
 *   clip-mask / filter），因此不支持 box-shadow 与 filter 类效果。
 */

* {
    font-family: core;
    box-sizing: border-box;
}

/* ===================== 主题变量（亮色，默认） ===================== */
body {
    /* 文本 */
    --fg: #241f31;
    --fg-muted: #9a9996;

    /* 表面 */
    --surface: #ffffff;
    --surface-alt: #f6f5f4;

    /* 边框 */
    --border: #cdc7c2;
    --border-light: #deddda;

    /* 强调色（亮/暗共用饱和蓝） */
    --accent: #3584e4;
    --accent-hover: #2f76d1;
    --accent-active: #1c71d8;
    --accent-fg: #ffffff;
    --link: #78aeed;
    --link-hover: #99c1f1;

    /* 语义色 */
    --success: #2ec27e;
    --success-text: #26a269;
    --warning: #e5a50a;
    --warning-alt: #e66100;
    --danger: #e01b24;
    --danger-text: #c01c28;

    /* 普通按钮 */
    --btn-top: #ffffff;
    --btn-bottom: #f2f2f2;
    --btn-hover-top: #f6f5f4;
    --btn-hover-bottom: #e9e9e7;
    --btn-active-top: #e5e5e5;
    --btn-active-bottom: #dbdbdb;
    --btn-disabled-top: #fafafa;
    --btn-disabled-bottom: #f2f2f2;
    --btn-border-hover: #9a9996;
    --btn-border-active: #77767b;

    /* 建议（强调）按钮（亮/暗共用饱和蓝） */
    --accent-btn-top: #3584e4;
    --accent-btn-bottom: #2f76d1;
    --accent-btn-hover-top: #2f76d1;
    --accent-btn-hover-bottom: #1c71d8;
    --accent-btn-active-top: #1c71d8;
    --accent-btn-active-bottom: #1a5fb4;
    --accent-btn-disabled-top: #99c1f1;
    --accent-btn-disabled-bottom: #99c1f1;
    --accent-btn-disabled-border: #99c1f1;

    /* 破坏性按钮（亮/暗共用红） */
    --danger-btn-top: #e01b24;
    --danger-btn-bottom: #c01c28;
    --danger-btn-hover-top: #c01c28;
    --danger-btn-hover-bottom: #a01820;
    --danger-btn-active-top: #a01820;
    --danger-btn-active-bottom: #8f141a;
    --danger-btn-border: #c01c28;

    /* 物品槽（覆盖在游戏画面上，亮色保证在深色/黑色背景下可见） */
    --slot-bg: #ffffffe0;
    --slot-border: #0000004d;
    --recipe-slot-bg: #3584e424;
    --recipe-slot-border: #3584e48c;
    --slot-selected-bg: #3584e42e;

    /* 浮层提示 / 通知 */
    --toast-bg: #212124d9;
    --toast-border: #ffffff1a;

    /* 控制台（跟随主题的终端） */
    --console-bg: #fafafaf5;
    --console-fg: #241f31;
    --console-muted: #9a9996;
    --console-panel-bg: #0000000d;
    --console-inset-bg: #0000000a;
    --console-border: #0000001f;
    --console-divider: #00000014;
    --console-keyword: #1c71d8;
    --console-suggestion: #5e5c64;
    --console-structure: #5e5c64;
    --console-structure-selected: #26a269;

    /* 滚动条（所有可滚动组件统一使用） */
    --scrollbar-track: #0000000d;
    --scrollbar-thumb: #00000040;
    --scrollbar-thumb-hover: #00000066;
}

/* ===================== 暗色主题 ===================== */
@media (theme: dark) {
    body {
        --fg: #ffffff;
        --fg-muted: #9a9996;

        --surface: #303030;
        --surface-alt: #3d3d3d;

        --border: #404040;
        --border-light: #3d3d3d;

        /* 语义色在暗色下提亮，保证对比度 */
        --success: #57e389;
        --success-text: #8ff0a4;
        --warning: #ffbe6d;
        --warning-alt: #ffa348;
        --danger: #ff8c82;
        --danger-text: #ffb4ab;

        /* 普通按钮（暗色表面，随层级抬升提亮） */
        --btn-top: #3d3d3d;
        --btn-bottom: #303030;
        --btn-hover-top: #454545;
        --btn-hover-bottom: #3a3a3a;
        --btn-active-top: #2b2b2b;
        --btn-active-bottom: #262626;
        --btn-disabled-top: #2b2b2b;
        --btn-disabled-bottom: #2a2a2a;
        --btn-border-hover: #9a9996;
        --btn-border-active: #77767b;

        /* 控制台（跟随主题的终端） */
        --console-bg: #242424f0;
        --console-fg: #ffffff;
        --console-muted: #9a9996;
        --console-panel-bg: #00000040;
        --console-inset-bg: #ffffff0f;
        --console-border: #ffffff14;
        --console-divider: #ffffff1a;
        --console-keyword: #78aeed;
        --console-suggestion: #c0c5ce;
        --console-structure: #a0a8b0;
        --console-structure-selected: #8ff0a4;

        /* 滚动条（所有可滚动组件统一使用） */
        --scrollbar-track: #ffffff14;
        --scrollbar-thumb: #ffffff40;
        --scrollbar-thumb-hover: #ffffff66;
    }
}

/* ===================== 基础元素 ===================== */

a {
    cursor: pointer;
    color: var(--link);
    text-decoration: none;
}

a:hover {
    color: var(--link-hover);
    text-decoration: underline;
}

button {
    width: 200dp;
    text-align: center;
    padding-left: 8dp;
    padding-right: 8dp;
    padding-top: 16dp;
    padding-bottom: 16dp;
    cursor: pointer;
    color: var(--fg);
    border: 1dp var(--border);
    border-radius: 8dp;
    decorator: vertical-gradient(var(--btn-top) var(--btn-bottom));
}

button:hover {
    color: var(--fg);
    border-color: var(--btn-border-hover);
    decorator: vertical-gradient(var(--btn-hover-top) var(--btn-hover-bottom));
}

button:active {
    color: var(--fg);
    border-color: var(--btn-border-active);
    decorator: vertical-gradient(var(--btn-active-top) var(--btn-active-bottom));
}

button[disabled] {
    cursor: default;
    color: var(--fg-muted);
    border-color: var(--border-light);
    decorator: vertical-gradient(var(--btn-disabled-top) var(--btn-disabled-bottom));
}

select {
    width: 300dp;
    padding-left: 8dp;
    padding-right: 8dp;
    padding-top: 16dp;
    padding-bottom: 16dp;
    cursor: pointer;
    color: var(--fg);
    background-color: var(--surface);
    border: 1dp var(--border);
    border-radius: 8dp;
}

option {
    width: 300dp;
    padding-left: 8dp;
    padding-right: 8dp;
    padding-top: 16dp;
    padding-bottom: 16dp;
    cursor: pointer;
    color: var(--fg);
    background-color: var(--surface);
}

option:hover {
    color: var(--accent-fg);
    background-color: var(--accent);
}

/* ===================== 滚动条（所有可滚动组件统一使用） ===================== */
scrollbarvertical {
    width: 10dp;
}

scrollbarhorizontal {
    height: 10dp;
}

scrollbarvertical slidertrack,
scrollbarhorizontal slidertrack {
    background-color: var(--scrollbar-track);
    border-radius: 5dp;
}

scrollbarvertical sliderbar,
scrollbarhorizontal sliderbar {
    background-color: var(--scrollbar-thumb);
    border-radius: 5dp;
}

scrollbarvertical sliderbar {
    margin-left: 1dp;
    margin-right: 1dp;
    min-height: 24dp;
}

scrollbarhorizontal sliderbar {
    margin-top: 1dp;
    margin-bottom: 1dp;
    min-width: 24dp;
}

scrollbarvertical sliderbar:hover,
scrollbarvertical sliderbar:active,
scrollbarhorizontal sliderbar:hover,
scrollbarhorizontal sliderbar:active {
    background-color: var(--scrollbar-thumb-hover);
}

scrollbarvertical sliderbar:disabled,
scrollbarhorizontal sliderbar:disabled {
    background-color: var(--scrollbar-track);
}

scrollbarcorner {
    background-color: transparent;
}

.panel {
    padding: 24dp;
    width: 560dp;
    display: flex;
    flex-direction: column;
    gap: 16dp;
    background-color: var(--surface);
    border: 1dp var(--border);
    border-radius: 12dp;
}

.dark_text {
    color: var(--fg);
}

input[type="text"] {
    width: 200dp;
    padding-left: 12dp;
    padding-right: 8dp;
    padding-top: 16dp;
    padding-bottom: 16dp;
    cursor: text;
    color: var(--fg);
    caret-color: var(--accent);
    background-color: var(--surface);
    border: 1dp var(--border);
    border-radius: 8dp;
}

input[type="text"]:focus {
    cursor: text;
    color: var(--fg);
    background-color: var(--surface);
    border-color: var(--accent);
}

input[type="checkbox"] {
    width: 32dp;
    height: 32dp;
    cursor: pointer;
    background-color: var(--surface);
    border: 2dp var(--fg-muted);
    border-radius: 6dp;
}

input[type="checkbox"]:checked {
    background-color: var(--accent);
    border-color: var(--accent);
}

h1 {
    font-size: 24dp;
}

h2 {
    font-size: 18dp;
}

h3 {
    font-size: 14dp;
}

.item_slot {
    position: relative;
    z-index: 0;
    width: 42dp;
    height: 42dp;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: var(--slot-bg);
    border: 2dp var(--slot-border);
    border-radius: 6dp;
}

.recipe_slot {
    position: relative;
    width: 42dp;
    height: 42dp;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: var(--recipe-slot-bg);
    border: 2dp var(--recipe-slot-border);
    border-radius: 6dp;
}

.item_slot[selected] {
    background-color: var(--slot-selected-bg);
    border: 2dp var(--accent);
}

.item_slot_icon {
    width: 32dp;
    height: 32dp;
}

.item_slot_count {
    position: absolute;
    bottom: 4dp;
    right: 4dp;
    font-size: 14dp;
}

.durability_bar {
    position: absolute;
    z-index: -1;
    top: 5dp;
    left: 5dp;
    right: 5dp;
    bottom: 5dp;
}

.durability_fill {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 100%;
    border-radius: 2dp;
}

.durability_fill.durability-high {
    background-color: var(--success);
}

.durability_fill.durability-mid {
    background-color: var(--warning);
}

.durability_fill.durability-low {
    background-color: var(--danger);
}
