button {
    font-family: core;
    padding: 12px 30dp;
    font-size: 18dp;
    background-color: #4a90d9;
    color: #ffffff;
    border-radius: 8dp;
    cursor: pointer;
}

button:hover {
    background-color: #5a9fe9;
    border-color: #4a8bd8;
}

button:active {
    background-color: #3a7bc8;
    border-color: #2a6bc7;
}

input {
    font-family: core;
}

p {
    font-family: core;
}

a {
    font-family: core;
    color: #4a90d9;
    text-decoration: none;
}

a:hover {
    text-decoration: underline;
}

* {
     box-sizing: border-box;
}