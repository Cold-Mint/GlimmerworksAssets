* {
    font-family: core;
    box-sizing: border-box;
}

a {
    cursor: pointer;
    color: #818cf8;
    text-decoration: none;
}

a:hover {
    color: #a5b4fc;
    text-decoration: underline;
}

button {
    width: 200dp;
    text-align: center;
    padding-left: 8dp;
    padding-right: 8dp;
    padding-top: 16dp;
    padding-bottom: 16dp;
    cursor: pointer;
    decorator: ninepatch-texture("texture://@core:gui/button", 28px, 28px, 28px, 28px);
}

button:hover {
    decorator: ninepatch-texture("texture://@core:gui/button_hovered", 28px, 28px, 28px, 28px);
}

button:active {
    decorator: ninepatch-texture("texture://@core:gui/button_pressed", 28px, 28px, 28px, 28px);
}

button[disabled] {
    cursor: default;
    color: #949694;
    decorator: ninepatch-texture("texture://@core:gui/button_disabled", 28px, 28px, 28px, 28px);
}

select {
    width: 300dp;
    padding-left: 8dp;
    padding-right: 8dp;
    padding-top: 16dp;
    padding-bottom: 16dp;
    cursor: pointer;
    decorator: ninepatch-texture("texture://@core:gui/input_text", 28px, 28px, 28px, 28px);
}

option {
    width: 300dp;
    padding-left: 8dp;
    padding-right: 8dp;
    padding-top: 16dp;
    padding-bottom: 16dp;
    cursor: pointer;
    decorator: ninepatch-texture("texture://@core:gui/option", 28px, 28px, 28px, 28px);
}

option:hover {
    decorator: ninepatch-texture("texture://@core:gui/option_hovered", 28px, 28px, 28px, 28px);
}


.panel {
    padding: 24dp;
    width: 560dp;
    display: flex;
    flex-direction: column;
    gap: 16dp;
    decorator: ninepatch-texture("texture://@core:gui/panel_bg", 8px, 8px, 8px, 8px);
}

.dark_text {
    color: black;
}

input[type="text"] {
    width: 200dp;
    padding-left: 12dp;
    padding-right: 8dp;
    padding-top: 16dp;
    padding-bottom: 16dp;
    cursor: text;
    decorator: ninepatch-texture("texture://@core:gui/input_text", 8px, 8px, 8px, 8px);
}

input[type="text"]:focus {
    cursor: text;
    decorator: ninepatch-texture("texture://@core:gui/input_text_focus", 8px, 8px, 8px, 8px);
}

input[type="checkbox"] {
    width: 32dp;
    height: 32dp;
    cursor: pointer;
    decorator: ninepatch-texture("texture://@core:gui/check_box", 2px, 2px, 2px, 2px);
}

input[type="checkbox"]:checked {
    decorator: ninepatch-texture("texture://@core:gui/check_box_checked", 2px, 2px, 2px, 2px);
}

h1 {
    font-size: 24dp;
}

h2 {
    font-size: 18dp;
}

h3 {
    font-size: 14dp;
}

.item_slot {
    position: relative;
    z-index: 0;
    width: 42dp;
    height: 42dp;
    display: flex;
    justify-content: center;
    align-items: center;
    decorator: ninepatch-texture("texture://@core:gui/item_slot", 8px, 8px, 8px, 8px);
}


.recipe_slot {
    position: relative;
    width: 42dp;
    height: 42dp;
    display: flex;
    justify-content: center;
    align-items: center;
    decorator: ninepatch-texture("texture://@core:gui/craft_preview_slot", 8px, 8px, 8px, 8px);
}

.item_slot[selected] {
    decorator: ninepatch-texture("texture://@core:gui/item_slot_selected", 8px, 8px, 8px, 8px);
}

.item_slot_icon {
    width: 32dp;
    height: 32dp;
}

.item_slot_count {
    position: absolute;
    bottom: 4dp;
    right: 4dp;
    font-size: 14dp;
}

.durability_bar {
    position: absolute;
    z-index: -1;
    top: 5dp;
    left: 5dp;
    right: 5dp;
    bottom: 5dp;
}

.durability_fill {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 100%;
}

.durability_fill.durability-high {
    background-color: #22c55e;
}

.durability_fill.durability-mid {
    background-color: #eab308;
}

.durability_fill.durability-low {
    background-color: #ef4444;
}
