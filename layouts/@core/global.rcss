* {
    font-family: core;
    box-sizing: border-box;
}

button {
    padding-left: 8dp;
    padding-right: 8dp;
    padding-top: 16dp;
    padding-bottom: 16dp;
    decorator: ninepatch-texture("texture://@core:gui/button", 2px, 2px, 2px, 2px);
}

button:hover {
    decorator: ninepatch-texture("texture://@core:gui/button_hovered", 2px, 2px, 2px, 2px);
}

button:active {
    decorator: ninepatch-texture("texture://@core:gui/button_pressed", 2px, 2px, 2px, 2px);
}

button:disabled {
    decorator: ninepatch-texture("texture://@core:gui/button_disabled", 2px, 2px, 2px, 2px);
}