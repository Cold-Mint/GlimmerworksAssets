.main {
    position: absolute;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

.title {
    position: absolute;
    top: 20dp;
    left: 50%;
    margin-left: -50dp;
    width: 100dp;
    text-align: center;
    font-size: 24dp;
    font-weight: bold;
    color: #333;
}

.button_container {
    display: flex;
    flex-direction: column;
    align-items: center;
}

.button_container button {
    margin-bottom: 15dp;
}

.copyright {
    position: absolute;
    bottom: 20dp;
    left: 20dp;
    font-size: 14dp;
    font-family: core;
}

.links {
    position: absolute;
    bottom: 20dp;
    right: 20dp;
    font-size: 14dp;
}

.links a {
    margin-left: 15dp;
}