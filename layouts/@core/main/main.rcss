.page {
    position: absolute;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
}

.logo {
    width: 200dp;
    height: 96dp;
    margin-top: 10%;
    decorator: image("texture://@core:gui/logo");
}

.button_container {
    margin-top: 10%;
    display: flex;
    flex-direction: column;
    gap: 8dp;
}

.links {
    display: flex;
    flex-direction: row;
    position: absolute;
    right: 8dp;
    bottom: 16dp;
    gap: 16dp;
}

.copyright {
    position: absolute;
    left: 8dp;
    bottom: 16dp;
}

.game_version {
    position: absolute;
    right: 8dp;
    top: 16dp;
}

.main_menu_background {
    position: absolute;
    width: 100%;
    height: 100%;
    z-index: -1;
}