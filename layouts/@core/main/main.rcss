.page {
    position: absolute;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
}

.logo {
    width: 384dp;
    height: 96dp;
    margin-top: 10%;
    decorator: image("texture://@core:gui/logo");
}

.button_container {
    margin-top: 10%;
    display: flex;
    flex-direction: column;
    gap: 8dp;
}

/* 主操作按钮：建议（强调）样式 */
#start_game {
    color: var(--accent-fg);
    border-color: var(--accent-hover);
    decorator: vertical-gradient(var(--accent-btn-top) var(--accent-btn-bottom));
}

#start_game:hover {
    color: var(--accent-fg);
    border-color: var(--accent-active);
    decorator: vertical-gradient(var(--accent-btn-hover-top) var(--accent-btn-hover-bottom));
}

#start_game:active {
    color: var(--accent-fg);
    border-color: var(--accent-active);
    decorator: vertical-gradient(var(--accent-btn-active-top) var(--accent-btn-active-bottom));
}

.links {
    display: flex;
    flex-direction: row;
    position: absolute;
    right: 8dp;
    bottom: 16dp;
    gap: 16dp;
}

.copyright {
    position: absolute;
    left: 8dp;
    bottom: 16dp;
}

.game_version {
    position: absolute;
    right: 8dp;
    top: 16dp;
}

.main_menu_background {
    position: absolute;
    width: 100%;
    height: 100%;
    z-index: -1;
}
