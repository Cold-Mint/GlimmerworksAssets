.page {
    position: absolute;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
}

.logo {
    width: 50dp;
    height: 150dp;
    decorator: image("texture://@core:gui/logo");
}

.main_menu_background {
    position: absolute;
    width: 100%;
    height: 100%;
    z-index: -1;
}