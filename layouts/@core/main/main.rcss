.main {
    position: absolute;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

.title {
    position: absolute;
    top: 20px;
    left: 50%;
    margin-left: -50px;
    width: 100px;
    text-align: center;
    font-size: 24px;
    font-weight: bold;
    color: #333;
}

.button_container {
    display: flex;
    flex-direction: column;
    align-items: center;
}

.button_container button {
    margin-bottom: 15px;
}

.copyright {
    position: absolute;
    bottom: 20px;
    left: 20px;
    font-size: 14px;
    font-family: core;
}

.links {
    position: absolute;
    bottom: 20px;
    right: 20px;
    font-size: 14px;
}

.links a {
    margin-left: 15px;
}